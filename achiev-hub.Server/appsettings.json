{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SteamApi": {
    "ApiKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=6110;Database=achievhub;Username=postgres;Password=postgres;SSL Mode=Disable"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "achiev-hub.Server",
    "Audience": "achiev-hub.Client",
