  },
  "SyncWorker": {
    "AppRole": "All",
    "Concurrency": 3,
    "BatchSize": 25,
    "SchemaTtlDays": 14,
    "NightlyCron": "0 0 * * *",
    "MaxAttempts": 5,
    "PollIntervalSeconds": 2,
    "MaxStoreEnrichPerLibrarySync": 5
  }
}
